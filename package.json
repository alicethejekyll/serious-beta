{
  "name": "renzhen-private-beta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/local.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/api-smoke.mjs",
    "start": "node build/server/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "retention": "tsx scripts/retention.ts",
    "qr": "tsx scripts/qr.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.18.6",
    "vite": "^7.1.7",
    "typescript": "^5.9.2",
    "tsx": "^4.20.6",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "packageManager": "pnpm@11.19.0"
}
